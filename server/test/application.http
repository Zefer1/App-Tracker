# updateApplication parcial: só status, resto deve ficar intacto
PUT http://localhost:3000/api/applications/1092db6d-efee-47f6-a99f-c0172d8f6ec8
Content-Type: application/json

{
  "status": "ENTREVISTA"
}

###

# updateApplication parcial: só company, resto (incluindo status acima) deve ficar intacto
PUT http://localhost:3000/api/applications/1092db6d-efee-47f6-a99f-c0172d8f6ec8
Content-Type: application/json

{
  "company": "PlanetSeason Corp"
}

###

# confirmar estado final: status = ENTREVISTA, company = PlanetSeason Corp, position/link/notes/user_id intactos
GET http://localhost:3000/api/applications


###

# sem login / sem cookie -> espera 401
GET http://localhost:3000/api/applications

###

# login -> guarda o cookie httpOnly na sessão do REST Client
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "zeferino@gmail.com",
  "password": "aldeiaMACACOS2012"
}

###

# mesma sessão/ficheiro, cookie enviado automaticamente -> espera 200
GET http://localhost:3000/api/applications

###

# GET de uma application específica, mesma sessão (cookie já ativo pelo login acima)
# troca o id abaixo por um id que apareça na resposta do GET /api/applications de cima
GET http://localhost:3000/api/applications/b8a33112-7510-4d0b-b15d-9e549f9c693a